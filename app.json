{
  "expo": {
    "name": "Meu Financeiro",
    "slug": "gestao-financeira-lembretes",
    "version": "1.0.0",
    "scheme": "meufinanceiro",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meufinanceiro.academico"
    },
    "android": {
      "package": "com.meufinanceiro.academico",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#163300"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAF4",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às fotos para escolher seu avatar no Meu Financeiro."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "66518668-f732-4c3d-93ef-dedea4e69e6e"
      }
    }
  }
}
